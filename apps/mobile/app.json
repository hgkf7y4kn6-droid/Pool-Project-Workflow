{
  "expo": {
    "name": "Pool PM",
    "slug": "pool-project-workflow",
    "version": "0.0.5",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "poolpm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.poolpm.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take progress, inspection and problem photos for your projects.",
        "NSPhotoLibraryUsageDescription": "Attach existing photos to projects and tasks.",
        "NSLocationWhenInUseUsageDescription": "Tag photos and measurements with the job-site location, and capture a property's GPS position.",
        "NSFaceIDUsageDescription": "Unlock Pool PM with Face ID."
      }
    },
    "android": {
      "package": "com.poolpm.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a2230",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#0a2230",
      "backgroundColor": "#f5f2ec",
      "name": "Pool PM",
      "shortName": "Pool PM",
      "description": "Run every pool build from lead to warranty — schedule, crews, photos, change orders and client approvals, online or off."
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f5f2ec",
          "dark": {
            "backgroundColor": "#071319",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Manrope-Light.ttf",
            "./assets/fonts/Manrope-Regular.ttf",
            "./assets/fonts/Manrope-Medium.ttf",
            "./assets/fonts/Manrope-SemiBold.ttf",
            "./assets/fonts/Manrope-Bold.ttf",
            "./assets/fonts/Manrope-ExtraBold.ttf",
            "./assets/fonts/Fraunces-SemiBold.ttf",
            "./assets/fonts/Fraunces-Bold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take progress, inspection and problem photos for your projects."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tag photos and measurements with the job-site location."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Pool PM with Face ID."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "http://localhost:4000",
      "eas": {
        "projectId": "bf141886-8bab-41b9-ab69-c1baf17d700f"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/bf141886-8bab-41b9-ab69-c1baf17d700f"
    },
    "owner": "richesdigitalventuress-team",
    "androidStatusBar": {
      "backgroundColor": "#f5f2ec"
    }
  }
}

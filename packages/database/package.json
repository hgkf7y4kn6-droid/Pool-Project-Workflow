{
  "name": "@pool/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./seed": "./src/seed.ts",
    "./password": "./src/password.ts",
    "./migrate": "./src/migrate.ts",
    "./migrate-cli": "./src/migrate-cli.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate-cli.ts",
    "seed": "tsx src/seed-cli.ts",
    "reset": "tsx src/reset.ts && tsx src/migrate-cli.ts && tsx src/seed-cli.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@pool/core": "*",
    "@pool/types": "*",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2"
  }
}

# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
PORT=4000
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:4000
APP_URL=poolpm://
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

DATABASE_URL=postgres://postgres:postgres@localhost:5432/pool_dev
# TLS to Postgres: disable (local) | require | verify-full. On Supabase use
# verify-full and paste the project's CA certificate (PEM or base64 of it).
DATABASE_SSL=disable
# DATABASE_SSL_CA=
# Migrations need a direct or session-mode connection (Supabase: "Session pooler", port 5432).
# MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pool_test
# Optional locally; enables BullMQ jobs, the worker, and multi-instance realtime.
REDIS_URL=redis://localhost:6379

# Generate: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=ZGV2LW9ubHktZGF0YS1rZXktMzItYnl0ZXMtbG9uZyE=

# Object storage: "local" (dev), "supabase" (Supabase Storage) or "s3" (AWS S3, R2, MinIO)
STORAGE_DRIVER=local
# Supabase (server only — the secret key must never go in EXPO_PUBLIC_* or the app)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_STORAGE_BUCKET=pool-pm-files
STORAGE_LOCAL_DIR=.storage
# S3_BUCKET=pool-pm-files
# S3_REGION=auto
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true

WEATHER_PROVIDER=open-meteo
PUSH_PROVIDER=log
# EXPO_ACCESS_TOKEN=
MAIL_PROVIDER=console
# RESEND_API_KEY=
# GOOGLE_OAUTH_CLIENT_IDS=
# APPLE_OAUTH_CLIENT_IDS=
# DESIGN_PROVIDER_HTTP_URL=
# DESIGN_PROVIDER_HTTP_TOKEN=
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# Mobile app (Expo) — public values only
EXPO_PUBLIC_API_URL=http://localhost:4000
